<?xml version="1.0" encoding="utf-8"?>
<Mod id="e8b1b318-ff13-4ef1-a9b9-5dbfd7334a1d" version="1">
  <Properties>
    <Name>Show Hero Lifespans Spike Tools v0.1.1.1</Name>
    <Teaser>Developer tools for the Show Hero Lifespans engine spikes.</Teaser>
    <Description>Version 0.1.1.1. Testing only. Open Hero Lifespan Spikes or press Ctrl+Shift+D. Prepare a new hotseat game with 3 humans and 1 AI, Heroes &amp; Legends, and manually recruit one hero for each human. Visibility Check compares the production reader and presentation for the current human observer, including actual fog reads. Check each human before meeting, after Meet Humans 1 &amp; 2, and after Meet All + Relationships. Setup buttons change diplomacy through synchronized requests and validate the sorted roles. Run All Spikes retains the countdown checker. The unsupported +5 probe was removed because GetLifespan is unavailable in gameplay. Save/load and add/remove checks use manual instructions. Requires Show Hero Lifespans, Gathering Storm and the Babylon Pack. Hotseat runtime coverage remains unverified until observed.</Description>
    <Authors>ThePotatoTurtle</Authors>
    <AffectsSavedGames>0</AffectsSavedGames>
    <CompatibleVersions>2.0</CompatibleVersions>
  </Properties>
  <Dependencies>
    <Mod id="4873eb62-8ccc-4574-b784-dda455e74e68" title="Expansion: Gathering Storm" />
    <Mod id="8424840C-92EF-4426-A9B4-B4E0CB818049" title="Babylon Pack" />
  </Dependencies>
  <ActionCriteria>
    <Criteria id="HLS_DEV_XP2">
      <GameCoreInUse>Expansion2</GameCoreInUse>
    </Criteria>
    <Criteria id="HLS_DEV_HEROES">
      <RuleSetInUse>RULESET_EXPANSION_2</RuleSetInUse>
      <ConfigurationValueMatches>
        <Group>Game</Group>
        <ConfigurationId>GAMEMODE_HEROES</ConfigurationId>
        <Value>1</Value>
      </ConfigurationValueMatches>
    </Criteria>
  </ActionCriteria>
  <InGameActions>
    <ImportFiles id="HLS_DEV_Imports" criteria="HLS_DEV_XP2">
      <File>UI/HLS_Probe.lua</File>
    </ImportFiles>
    <AddGameplayScripts id="HLS_DEV_Gameplay" criteria="HLS_DEV_HEROES">
      <Properties><LoadOrder>14000</LoadOrder></Properties>
      <File>Scripts/HLS_Dev_Gameplay.lua</File>
    </AddGameplayScripts>
    <AddUserInterfaces id="HLS_DEV_UI" criteria="HLS_DEV_XP2">
      <Properties><Context>InGame</Context><LoadOrder>14000</LoadOrder></Properties>
      <File>UI/HLS_Dev_Panel.xml</File>
    </AddUserInterfaces>
  </InGameActions>
  <Files>
    <File>Scripts/HLS_Dev_Gameplay.lua</File>
    <File>UI/HLS_Dev_Panel.lua</File>
    <File>UI/HLS_Dev_Panel.xml</File>
    <File>UI/HLS_Probe.lua</File>
  </Files>
</Mod>
